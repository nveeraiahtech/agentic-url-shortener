Table 1: URLS
Purpose

Stores original URLs and generated short codes.

SQL

CREATE TABLE urls (
id BIGINT AUTO_INCREMENT PRIMARY KEY,
original_url VARCHAR(2000) NOT NULL,
short_code VARCHAR(20) NOT NULL UNIQUE
);

Sample Data
id	original_url	short_code
1	https://google.com	abc12

Table 2: ANALYTICS
Purpose

Tracks URL usage statistics.

SQL
SQL
CREATE TABLE analytics (
id BIGINT AUTO_INCREMENT PRIMARY KEY,
short_code VARCHAR(20) NOT NULL,
click_count BIGINT DEFAULT 0,
last_accessed TIMESTAMP NULL
);

Sample Data
id	short_code	click_count
1	abc123	     5

Table 3: WORKFLOW_AUDIT
Purpose

Stores workflow execution history for governance and traceability.

SQL
CREATE TABLE workflow_audit (
id BIGINT AUTO_INCREMENT PRIMARY KEY,
agent_name VARCHAR(100),
status VARCHAR(50),
created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

Sample Data
id	agent_name	         status
1	RequirementAgent	 SUCCESS
2	DesignAgent	         SUCCESS
3	ImplementationAgent	 SUCCESS

